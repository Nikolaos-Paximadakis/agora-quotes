# Copy to .env (never commit .env). All variables are optional.

# Default provider and optional fallback: yahoo | twelvedata | eodhd
AGORA_QUOTES_PROVIDER=yahoo
AGORA_QUOTES_FALLBACK=
# Quote cache lifetime in seconds (0 disables the cache)
AGORA_QUOTES_CACHE_TTL=60

# API keys, needed only for the providers that use them
TWELVEDATA_API_KEY=
EODHD_API_KEY=

# Set to 1 to run tests that hit the real network
AGORA_QUOTES_LIVE_TESTS=0
